<window name="link_page" style:normal:bg_color="#000000" style:normal:border_color="#000000">
  <!-- ══ Frame 4 layout ═══════════════════════════════════════════════
       VIDEO  : (0,60)   800×480  alpha hole punched by post-render hook
       RIGHT  : (800,60) 224×480  opaque panel — speed/gear/power/battery
       TOP    : (0,0)    1024×60  clock + signal icons (black bg)
       BOTTOM : (0,548)  1024×52  mileage + electrical (black bg)
       ═════════════════════════════════════════════════════════════════ -->

  <!-- ── Top bar (0,0) 1024×60 — mirrors home_page, black bg ── -->
  <view name="link_time_view" x="1" y="6" w="130" h="50">
    <label name="link_time_min" x="0" y="0" w="51" h="50" style:normal:font_size="44" style:normal:text_align_v="top" text="00"/>
    <label name="link_time_colon" x="32" y="-8" w="41" h="52" style:normal:font_size="51" style:normal:text_align_v="top" text=":"/>
    <label name="link_time_sec" x="49" y="0" w="60" h="50" style:normal:font_size="44" style:normal:text_align_v="top" text="00"/>
    <label name="link_time_ampm" x="96" y="18" w="34" h="32" style:normal:font_size="18" style:normal:text_align_v="bottom" visible="false" text=""/>
  </view>
  <view name="link_signal_view" x="100" y="0" w="924" h="62">
    <image name="link_icon_GMS" x="0" y="0" w="52" h="52" draw_type="default" image="top_signal_3_n"/>
    <image name="link_icon_gps" x="47" y="0" w="52" h="52" draw_type="default" image="top_gps_n"/>
    <image name="link_icon_bt" x="99" y="0" w="52" h="52" draw_type="default" image="top_bluetooth_n"/>
    <image name="link_icon_high_beam" x="163" y="0" w="52" h="52" draw_type="default" image="top_high_beam_n"/>
    <image name="link_icon_left_bg" x="284" y="0" w="52" h="52" draw_type="default" image="top_left"/>
    <image name="link_icon_left" x="284" y="0" w="52" h="52" draw_type="default" image="top_left_n"/>
    <image name="link_icon_ready_bg" x="348" y="0" w="130" h="52" draw_type="default" image="top_ready"/>
    <image name="link_icon_ready" x="348" y="0" w="130" h="52" draw_type="default" image="top_ready_n" visible="true"/>
    <image name="link_icon_right_bg" x="489" y="0" w="52" h="52" draw_type="default" image="top_right"/>
    <image name="link_icon_right" x="489" y="0" w="52" h="52" draw_type="default" image="top_right_n"/>
    <image name="link_icon_near_beam" x="559" y="0" w="52" h="52" draw_type="default" image="top_auto_high_beams_n"/>
    <image name="link_icon_radar" x="614" y="0" w="52" h="52" draw_type="default" image="top_radar_n" visible="false"/>
    <image name="link_icon_abs" x="668" y="0" w="52" h="52" draw_type="default" image="top_abs_n"/>
    <image name="link_icon_ecu" x="727" y="0" w="52" h="52" draw_type="default" image="top_ecu_n"/>
    <image name="link_icon_tcs" x="790" y="0" w="52" h="52" draw_type="default" image="top_tcs_n"/>
    <image name="link_icon_engine" x="860" y="0" w="52" h="52" draw_type="default" image="top_brake_failure_n"/>
  </view>

  <!-- ── Right panel background (800,60) 224×480 ── -->
  <image name="right_panel_bg" x="800" y="60" w="224" h="480" draw_type="default" image="interconnection_bg"/>

  <!-- ── Speed: image_value digits at (867,92) ── -->
  <image_value name="speed_lab" x="867" y="92" w="90" h="64" image="power_" format="%d" value="0" min="0" max="200"/>
  <label name="unit_lab" x="874" y="164" w="83" h="41" style:normal:text_color="#606060" style:normal:font_size="35" text="km/h"/>

  <!-- divider -->
  <view x="800" y="210" w="224" h="1" style:normal:bg_color="#333333"/>

  <!-- ── Drive mode + Gear (view, not slide_menu — all 3 always visible) ── -->
  <image name="ride_mode_img" x="821" y="222" w="32" h="50" draw_type="default" image="link_drv_mode_0"/>
  <view name="gear_view" x="882" y="220" w="116" h="52">
    <image name="gear_N" x="0" y="0" w="32" h="52" draw_type="center" style:normal:icon="gear_n_n" style:selected:icon="gear_n_p"/>
    <image name="gear_D" x="42" y="0" w="32" h="52" draw_type="center" style:normal:icon="gear_d_n" style:selected:icon="gear_d_p"/>
    <image name="gear_R" x="84" y="0" w="32" h="52" draw_type="center" style:normal:icon="gear_r_n" style:selected:icon="gear_r_p"/>
  </view>

  <!-- divider -->
  <view x="800" y="300" w="224" h="1" style:normal:bg_color="#333333"/>

  <!-- ── Power ── -->
  <label name="power_lab" x="875" y="319" w="61" h="34" style:normal:text_color="#FFFFFF" style:normal:font_size="33" style:normal:text_align_h="right" text="0"/>
  <label name="label1" x="938" y="319" w="23" h="34" style:normal:text_color="#327889" style:normal:font_size="33" style:normal:text_align_h="left" text="w"/>
  <slider name="power_bar" x="866" y="383" w="100" h="22" style:normal:icon="box_power_pointer" style:pressed:icon="" style:over:icon="" style:disable:icon="" style:focused:icon="" style:normal:bg_color="#848484" style:normal:fg_color="#FFFFFF" style:normal:round_radius="0" bar_size="5" dragger_size="0" value="0"/>

  <!-- divider -->
  <view x="800" y="420" w="224" h="1" style:normal:bg_color="#333333"/>

  <!-- ── Battery / Range ── -->
  <label name="elec_lab" x="865" y="440" w="61" h="34" style:normal:text_color="#FFFFFF" style:normal:font_size="33" style:normal:text_align_h="right" text="0"/>
  <label name="elec_unit" x="926" y="440" w="41" h="34" style:normal:text_color="#327889" style:normal:font_size="33" style:normal:text_align_h="left" text="km"/>
  <progress_bar name="elec_bar" x="869" y="491" w="90" h="30" style:normal:text_color="#000000" style:normal:fg_color="#FF0000" style:normal:bg_color="#FFFFFF" show_text="true" style:normal:font_size="25" style:normal:font_name="default" style:normal:margin="0" style:normal:border_width="4" style:normal:border_color="#FFFFFF" style:normal:round_radius="6" format="%d%%" value="0"/>
  <image name="image3" x="954" y="499" w="9" h="15" draw_type="default" image="link_elecRect_head"/>

  <!-- divider -->
  <view x="800" y="540" w="224" h="1" style:normal:bg_color="#333333"/>

  <!-- ── Bottom bar (0,548) 1024×52 — mirrors home_page mileage + electrical, black bg ── -->
  <view name="link_mileage_view" x="1" y="548" w="1023" h="52">
    <label name="link_trip_title" x="0" y="5" w="55" h="35" style:normal:font_size="27" style:normal:text_align_v="bottom" text="TRIP"/>
    <label name="link_trip_label" x="55" y="9" w="70" h="35" style:normal:font_size="35" style:normal:text_align_h="right" style:normal:text_align_v="bottom" text="0.0"/>
    <label name="link_trip_unit" x="131" y="9" w="49" h="35" style:normal:font_size="35" style:normal:text_align_h="left" style:normal:text_align_v="bottom" text="km"/>
    <label name="link_odo_title" x="964" y="6" w="55" h="35" style:normal:font_size="27" style:normal:text_align_v="bottom" text="ODO"/>
    <label name="link_odo_label" x="809" y="9" w="102" h="35" style:normal:font_size="35" style:normal:text_align_h="right" style:normal:text_align_v="bottom" text="0"/>
    <label name="link_odo_unit" x="916" y="9" w="44" h="35" style:normal:font_size="35" style:normal:text_align_h="left" style:normal:text_align_v="bottom" text="km"/>
  </view>
  <view name="link_electrical_view" x="228" y="548" w="568" h="52" style:normal:bg_image="power_level_bg">
    <progress_bar name="link_electrical_bar" x="192" y="20" w="186" h="12" style:normal:text_color="#00000000" style:normal:bg_color="#00000000" style:normal:bg_image="power_level_n" style:normal:fg_color="#00FF00" style:normal:bg_image_draw_type="icon" style:normal:border_color="#00000000" value="100"/>
    <label name="link_elec_percentage" x="95" y="10" w="38" h="35" style:normal:font_size="35" style:normal:text_align_h="right" style:normal:text_align_v="bottom" text="100"/>
    <label name="link_elec_percent_sign" x="132" y="10" w="31" h="35" style:normal:font_size="33" style:normal:text_align_v="bottom" text="%"/>
    <label name="link_elec_range_value" x="379" y="10" w="61" h="35" style:normal:font_size="35" style:normal:text_align_h="right" style:normal:text_align_v="bottom" text="100"/>
    <label name="link_elec_range_unit" x="445" y="10" w="52" h="35" style:normal:font_size="35" style:normal:text_align_h="left" style:normal:text_align_v="bottom" text="km"/>
  </view>

  <!-- ── QR code: centered in video area, hidden after carlink connects ── -->
  <qr name="link_qr" x="280" y="200" w="239" h="235" value="http://www.carbit.com.cn/down6/642/643/_ylqx?modelid=30507&amp;sn=Ph5z&amp;action=9&amp;ssid=HCN-00B2&amp;pwd=88888888&amp;auth=WPA-PSK&amp;name=HCN-00B2-p2p" style:normal:fg_color="#000000" style:normal:bg_color="#FFFFFF" visible="true"/>

  <?include filename="component.xml" ?>
</window>