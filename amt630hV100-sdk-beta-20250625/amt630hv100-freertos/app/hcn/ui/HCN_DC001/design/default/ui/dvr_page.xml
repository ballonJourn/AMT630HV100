<window name="dvr_page" style:normal:bg_color="#FF000000" style:normal:border_color="#FF000000">
  <!-- DVR main view: preview area (0,0,1024,500) + bottom dock (0,500,1024,100) -->
  <view name="dvr_main_view" x="0" y="0" w="1024" h="600" visible="true">
    <!-- Background image: visible in MAIN (no preview), hidden in CAM_SW/PLAYBACK (preview on) -->
    <image name="dvr_main_bg" x="0" y="0" w="1024" h="500" draw_type="default" image="dvr_bg" visible="true"/>
    <!-- Main dock: 4 buttons, 256px per section -->
    <view name="dvr_dock_bar" x="0" y="500" w="1024" h="100" style:normal:bg_image="dock_bg">
      <image name="dvr_btn_preview"  x="48"  y="0" w="160" h="100" draw_type="default" style:normal:icon="icon_camera_n"   style:selected:icon="icon_camera_p"/>
      <image name="dvr_dock_line1"   x="256" y="0" w="1"   h="100" draw_type="default" image="line"/>
      <image name="dvr_btn_video_pb" x="304" y="0" w="160" h="100" draw_type="default" style:normal:icon="icon_playback_n" style:selected:icon="icon_playback_p"/>
      <image name="dvr_dock_line2"   x="512" y="0" w="1"   h="100" draw_type="default" image="line"/>
      <image name="dvr_btn_photo_pb" x="560" y="0" w="160" h="100" draw_type="default" style:normal:icon="icon_photo_n"    style:selected:icon="icon_photo_p"/>
      <image name="dvr_dock_line3"   x="768" y="0" w="1"   h="100" draw_type="default" image="line"/>
      <image name="dvr_btn_settings" x="816" y="0" w="160" h="100" draw_type="default" style:normal:icon="icon_settings_n" style:selected:icon="icon_settings_p"/>
    </view>
    <!-- Camera sub-dock: 3 sections, 341px each -->
    <view name="dvr_cam_dock" x="0" y="500" w="1024" h="100" visible="false" style:normal:bg_image="dock_bg">
      <image name="dvr_cam_tab_sel" x="0"   y="0" w="341" h="100" draw_type="default" image="dock_selected"/>
      <image name="dvr_cam_line1"   x="341" y="0" w="1"   h="100" draw_type="default" image="line"/>
      <image name="dvr_cam_line2"   x="682" y="0" w="1"   h="100" draw_type="default" image="line"/>
      <label name="dvr_cam_front"   x="86"  y="19" w="168" h="61" style:normal:font_size="30" style:normal:text_align_h="center" tr_text="dvr_front_video"/>
      <label name="dvr_cam_rear"    x="427" y="19" w="168" h="61" style:normal:font_size="30" style:normal:text_align_h="center" tr_text="dvr_rear_video"/>
      <image name="dvr_cam_snap_icon" x="812" y="10" w="80" h="80" draw_type="default" style:normal:icon="icon_photo_n" style:selected:icon="icon_photo_p"/>
    </view>
  </view>

  <!-- Idle view: dvr_bg image + bottom dock (shown after playback BACK, no file list) -->
  <view name="dvr_idle_view" x="0" y="0" w="1024" h="600" visible="false">
    <image name="dvr_idle_bg" x="0" y="0" w="1024" h="500" draw_type="default" image="dvr_bg"/>
    <view name="dvr_idle_dock" x="0" y="500" w="1024" h="100" style:normal:bg_image="dock_bg">
      <image name="dvr_idle_tab_sel"   x="0"   y="0" w="512" h="100" draw_type="scale" image="dock_selected"/>
      <image name="dvr_idle_line"      x="512" y="0" w="1"   h="100" draw_type="default" image="line"/>
      <label name="dvr_idle_tab_left"  x="156" y="19" w="200" h="61" style:normal:font_size="30" style:normal:text_align_h="center" text="Front Video"/>
      <label name="dvr_idle_tab_right" x="668" y="19" w="200" h="61" style:normal:font_size="30" style:normal:text_align_h="center" text="Rear Video"/>
    </view>
  </view>

  <!-- File list overlay -->
  <view name="dvr_list_view" x="0" y="0" w="1024" h="600" visible="false">
    <image name="dvr_list_bg_img" x="0" y="0" w="1024" h="600" draw_type="default" image="dvr_list_bg"/>
    <scroll_view name="dvr_file_scroll" x="44" y="10" w="936" h="480" yslidable="true" xslidable="false">
      <view name="dvr_file_item_0" x="0" y="0" w="600" h="60" style:normal:bg_image="list_bg_n">
        <image name="dvr_file_icon_0" x="10" y="0" w="60" h="60" draw_type="default" style:normal:icon="list_icon_video_n" style:selected:icon="list_icon_video_p"/>
        <label name="dvr_file_name_0" x="80" y="12" w="320" h="35" style:normal:font_size="28"/>
        <image name="dvr_file_view_0" x="390" y="0" w="100" h="60" draw_type="default" style:normal:icon="icon_view_n" style:selected:icon="icon_view_p"/>
        <image name="dvr_file_del_0" x="500" y="0" w="100" h="60" draw_type="default" style:normal:icon="icon_delete_n" style:selected:icon="icon_delete_p"/>
      </view>
      <view name="dvr_file_item_1" x="0" y="70" w="600" h="60" style:normal:bg_image="list_bg_n">
        <image name="dvr_file_icon_1" x="10" y="0" w="60" h="60" draw_type="default" style:normal:icon="list_icon_video_n" style:selected:icon="list_icon_video_p"/>
        <label name="dvr_file_name_1" x="80" y="12" w="320" h="35" style:normal:font_size="28"/>
        <image name="dvr_file_view_1" x="390" y="0" w="100" h="60" draw_type="default" style:normal:icon="icon_view_n" style:selected:icon="icon_view_p"/>
        <image name="dvr_file_del_1" x="500" y="0" w="100" h="60" draw_type="default" style:normal:icon="icon_delete_n" style:selected:icon="icon_delete_p"/>
      </view>
      <view name="dvr_file_item_2" x="0" y="140" w="600" h="60" style:normal:bg_image="list_bg_n">
        <image name="dvr_file_icon_2" x="10" y="0" w="60" h="60" draw_type="default" style:normal:icon="list_icon_video_n" style:selected:icon="list_icon_video_p"/>
        <label name="dvr_file_name_2" x="80" y="12" w="320" h="35" style:normal:font_size="28"/>
        <image name="dvr_file_view_2" x="390" y="0" w="100" h="60" draw_type="default" style:normal:icon="icon_view_n" style:selected:icon="icon_view_p"/>
        <image name="dvr_file_del_2" x="500" y="0" w="100" h="60" draw_type="default" style:normal:icon="icon_delete_n" style:selected:icon="icon_delete_p"/>
      </view>
      <view name="dvr_file_item_3" x="0" y="210" w="600" h="60" style:normal:bg_image="list_bg_n">
        <image name="dvr_file_icon_3" x="10" y="0" w="60" h="60" draw_type="default" style:normal:icon="list_icon_video_n" style:selected:icon="list_icon_video_p"/>
        <label name="dvr_file_name_3" x="80" y="12" w="320" h="35" style:normal:font_size="28"/>
        <image name="dvr_file_view_3" x="390" y="0" w="100" h="60" draw_type="default" style:normal:icon="icon_view_n" style:selected:icon="icon_view_p"/>
        <image name="dvr_file_del_3" x="500" y="0" w="100" h="60" draw_type="default" style:normal:icon="icon_delete_n" style:selected:icon="icon_delete_p"/>
      </view>
      <view name="dvr_file_item_4" x="0" y="280" w="600" h="60" style:normal:bg_image="list_bg_n">
        <image name="dvr_file_icon_4" x="10" y="0" w="60" h="60" draw_type="default" style:normal:icon="list_icon_video_n" style:selected:icon="list_icon_video_p"/>
        <label name="dvr_file_name_4" x="80" y="12" w="320" h="35" style:normal:font_size="28"/>
        <image name="dvr_file_view_4" x="390" y="0" w="100" h="60" draw_type="default" style:normal:icon="icon_view_n" style:selected:icon="icon_view_p"/>
        <image name="dvr_file_del_4" x="500" y="0" w="100" h="60" draw_type="default" style:normal:icon="icon_delete_n" style:selected:icon="icon_delete_p"/>
      </view>
      <view name="dvr_file_item_5" x="0" y="350" w="600" h="60" style:normal:bg_image="list_bg_n">
        <image name="dvr_file_icon_5" x="10" y="0" w="60" h="60" draw_type="default" style:normal:icon="list_icon_video_n" style:selected:icon="list_icon_video_p"/>
        <label name="dvr_file_name_5" x="80" y="12" w="320" h="35" style:normal:font_size="28"/>
        <image name="dvr_file_view_5" x="390" y="0" w="100" h="60" draw_type="default" style:normal:icon="icon_view_n" style:selected:icon="icon_view_p"/>
        <image name="dvr_file_del_5" x="500" y="0" w="100" h="60" draw_type="default" style:normal:icon="icon_delete_n" style:selected:icon="icon_delete_p"/>
      </view>
    </scroll_view>
    <label name="dvr_list_no_sd" x="362" y="200" w="300" h="60" visible="false" style:normal:font_size="32" style:normal:text_color="#FFFFFFFF" text="No SD Card"/>
    <!-- Bottom tab: 2-tab, 512px each, text centered -->
    <view name="dvr_list_dock" x="0" y="500" w="1024" h="100" style:normal:bg_image="dock_bg">
      <image name="dvr_list_tab_sel"    x="0"   y="0" w="512" h="100" draw_type="scale" image="dock_selected"/>
      <image name="dvr_list_line"       x="512" y="0" w="1"   h="100" draw_type="default" image="line"/>
      <label name="dvr_tab_label_left"  x="156" y="19" w="200" h="61" style:normal:font_size="30" style:normal:text_align_h="center" text="Front Video"/>
      <label name="dvr_tab_label_right" x="668" y="19" w="200" h="61" style:normal:font_size="30" style:normal:text_align_h="center" text="Rear Video"/>
    </view>
  </view>

  <!-- Settings overlay -->
  <view name="dvr_setting_view" x="0" y="0" w="1024" h="600" visible="false">
    <image name="dvr_set_bg" x="0" y="0" w="1024" h="600" draw_type="default" image="dvr_list_bg"/>
    <view name="dvr_set_row_camera" x="57" y="110" w="910" h="80">
      <image name="dvr_set_cam_label_bg" x="0" y="0" w="250" h="80" draw_type="default" style:normal:icon="settings_btn1_n" style:selected:icon="settings_btn1_p"/>
      <image name="dvr_set_cam_on_bg" x="270" y="0" w="200" h="80" draw_type="default" style:normal:icon="settings_btn2_n" style:selected:icon="settings_btn2_p"/>
      <image name="dvr_set_cam_off_bg" x="490" y="0" w="200" h="80" draw_type="default" style:normal:icon="settings_btn2_n" style:selected:icon="settings_btn2_p"/>
      <label name="dvr_set_cam_label" x="80" y="18" w="90" h="43" style:normal:font_size="30" tr_text="dvr_camera"/>
      <label name="dvr_set_cam_on" x="305" y="18" w="60" h="43" style:normal:font_size="30" tr_text="dvr_on"/>
      <image name="dvr_set_cam_on_sel" x="278" y="28" w="24" h="24" draw_type="default" image="settings_s"/>
      <label name="dvr_set_cam_off" x="530" y="18" w="60" h="43" style:normal:font_size="30" tr_text="dvr_off"/>
    </view>
    <view name="dvr_set_row_loop" x="57" y="210" w="910" h="80">
      <image name="dvr_set_loop_label_bg" x="0" y="0" w="250" h="80" draw_type="default" style:normal:icon="settings_btn1_n" style:selected:icon="settings_btn1_p"/>
      <image name="dvr_set_loop_1_bg" x="270" y="0" w="200" h="80" draw_type="default" style:normal:icon="settings_btn2_n" style:selected:icon="settings_btn2_p"/>
      <image name="dvr_set_loop_2_bg" x="490" y="0" w="200" h="80" draw_type="default" style:normal:icon="settings_btn2_n" style:selected:icon="settings_btn2_p"/>
      <image name="dvr_set_loop_3_bg" x="710" y="0" w="200" h="80" draw_type="default" style:normal:icon="settings_btn2_n" style:selected:icon="settings_btn2_p"/>
      <label name="dvr_set_loop_label" x="65" y="18" w="120" h="43" style:normal:font_size="30" tr_text="dvr_loop_time"/>
      <label name="dvr_set_loop_1" x="303" y="18" w="80" h="43" style:normal:font_size="30" text="1 min"/>
      <image name="dvr_set_loop_sel" x="278" y="28" w="24" h="24" draw_type="default" image="settings_s"/>
      <label name="dvr_set_loop_2" x="523" y="18" w="80" h="43" style:normal:font_size="30" text="2 min"/>
      <label name="dvr_set_loop_3" x="743" y="18" w="80" h="43" style:normal:font_size="30" text="3 min"/>
    </view>
    <view name="dvr_set_row_format" x="57" y="310" w="910" h="80">
      <image name="dvr_set_fmt_label_bg" x="0" y="0" w="250" h="80" draw_type="default" style:normal:icon="settings_btn1_n" style:selected:icon="settings_btn1_p"/>
      <image name="dvr_set_fmt_btn_bg" x="270" y="0" w="640" h="80" draw_type="default" style:normal:icon="settings_btn3_n" style:selected:icon="settings_btn3_p"/>
      <label name="dvr_set_fmt_label" x="80" y="18" w="90" h="43" style:normal:font_size="30" tr_text="dvr_format"/>
      <label name="dvr_set_fmt_btn" x="465" y="18" w="150" h="43" style:normal:font_size="30" tr_text="dvr_quick_format"/>
    </view>
    <view name="dvr_set_row_about" x="57" y="410" w="910" h="80">
      <image name="dvr_set_about_label_bg" x="0" y="0" w="250" h="80" draw_type="default" style:normal:icon="settings_btn1_n" style:selected:icon="settings_btn1_p"/>
      <image name="dvr_set_about_info_bg" x="270" y="0" w="640" h="80" draw_type="default" style:normal:icon="settings_btn3_n" style:selected:icon="settings_btn3_p"/>
      <label name="dvr_set_about_label" x="80" y="18" w="90" h="43" style:normal:font_size="30" tr_text="dvr_about"/>
      <progress_bar name="dvr_storage_bar" x="300" y="30" w="360" h="20" style:normal:bg_image="storage_n" style:normal:fg_image="storage_p" value="50"/>
      <label name="dvr_storage_text" x="683" y="19" w="123" h="43" style:normal:font_size="28" text="10G/20G"/>
    </view>
  </view>

  <!-- Confirm popup (centered in 1024) -->
  <view name="dvr_popup_view" x="262" y="165" w="500" h="270" visible="false">
    <image name="dvr_popup_bg" x="0" y="0" w="500" h="270" draw_type="default" image="pop up_bg"/>
    <label name="dvr_popup_title" x="170" y="60" w="160" h="46" style:normal:font_size="33" tr_text="dvr_confirm_delete"/>
    <image name="dvr_popup_confirm_bg" x="50" y="170" w="180" h="60" draw_type="default" style:normal:icon="pop up_btn_n" style:selected:icon="pop up_btn_p"/>
    <label name="dvr_popup_confirm" x="112" y="179" w="56" h="41" style:normal:font_size="30" tr_text="dvr_confirm"/>
    <image name="dvr_popup_cancel_bg" x="270" y="170" w="180" h="60" draw_type="default" style:normal:icon="pop up_btn_n" style:selected:icon="pop up_btn_p"/>
    <label name="dvr_popup_cancel" x="332" y="179" w="56" h="41" style:normal:font_size="30" tr_text="dvr_cancel"/>
  </view>
</window>